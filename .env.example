# HADES configuration — copy to .env and fill in. Never commit .env.
HELIUS_API_KEY=your-helius-api-key
DATABASE_URL=sqlite:///./hades.db
HADES_API_KEY=change-me-long-random-string
HELIUS_WEBHOOK_SECRET=change-me-webhook-secret
HELIUS_WEBHOOK_ID=
PUBLIC_WEBHOOK_URL=https://your-public-host.example
HELIUS_MAX_PAGES_PER_ADDRESS=20
EARLY_BUYERS_N=100
SIG_SCAN_MAX_PAGES=30
RATE_LIMIT_RPS=8

# --- Hyperliquid head (hyperliquid/, CLI hades-hl, port 8010) ---
# X-Hades-Key for the HL head API (also set in web/.env.local as HL_API_KEY).
HL_API_KEY=
HL_API_URL=http://127.0.0.1:8010
# Relative to the working directory: run hades-hl from the repo root (as scripts/dev.sh
# does) or use an absolute path, or the CLI and `serve` use two different databases.
HL_DATABASE_URL=sqlite:///hades_hl.db
HL_INFO_URL=https://api.hyperliquid.xyz/info
HL_WS_URL=wss://api.hyperliquid.xyz/ws
HL_LEADERBOARD_URL=https://stats-data.hyperliquid.xyz/Mainnet/leaderboard
HL_MAX_FOLLOWS=25
HL_AUTO_FOLLOW_N=10
# Per-IP REST weight budget (HL docs: 1200/min).
HL_RATE_WEIGHT_PER_MIN=1200
