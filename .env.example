# HADES configuration — copy to .env and fill in. Never commit .env.
HELIUS_API_KEY=your-helius-api-key
DATABASE_URL=sqlite:///./hades.db
HADES_API_KEY=change-me-long-random-string
HELIUS_WEBHOOK_SECRET=change-me-webhook-secret
HELIUS_WEBHOOK_ID=
PUBLIC_WEBHOOK_URL=https://your-public-host.example/webhook/helius
HELIUS_MAX_PAGES_PER_ADDRESS=20
EARLY_BUYERS_N=100
SIG_SCAN_MAX_PAGES=30
RATE_LIMIT_RPS=8
