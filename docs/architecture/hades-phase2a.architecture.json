  "cards": [
    { "dot": "emerald", "title": "Paper rules", "items": [
      "Copy price is our recorded mid plus spread and slippage, never the leader's fill price",
      "No live price within 30 s of observation: the copy is missed",
      "Paper starts at follow_started_at; bankroll 10,000 USD, 5% of current equity as margin, leverage capped at 10x"
    ] },
    { "dot": "violet", "title": "Gate and ladder", "items": [
      "Gate: >= 28 days, >= 30 closed trades, net > 0, max DD < 20%, top trade <= 50% of net",
      "PAPER -> NOTIF when the gate passes; COPY only by owner action",
      "Rolling net <= 0 or rolling DD >= 20% demotes to PAPER"
    ] },
    { "dot": "rose", "title": "Boundaries", "items": [
      "Every process binds 127.0.0.1; head keys stay on the Next.js server",
      "No keys, no signing, no orders: Hyperliquid is read through public endpoints only",
      "Head API responses use the hades-core contract (HeadHealth, WalletRow, PaperSummary, Alert)"
    ] },
    { "dot": "amber", "title": "Solana head (Phase 1)", "items": [
      "Reads DexScreener and Helius; not drawn here",
      "No paper following: the arena and follows routes use the Hyperliquid head"
