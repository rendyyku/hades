# Copy to web/.env.local (dev). Same HADES_API_KEY as the engine's .env.
HADES_API_URL=http://127.0.0.1:8000
HADES_API_KEY=
# Exact origins (comma-separated) allowed to use the server routes. Watchlist/mute writes need
# Origin in this list AND Host in its hosts; /api/signals and /api/stream need the Host.
HADES_PUBLIC_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
