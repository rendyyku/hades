HADES_API_URL=http://127.0.0.1:8000
HADES_API_KEY=your-hades-api-key
# Exact origins (comma-separated) allowed to use the server routes. Watchlist writes need
# Origin in this list AND Host in its hosts; /api/alerts and /api/stream need the Host.
HADES_PUBLIC_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Hyperliquid head (hades-hl serve, port 8010)
HL_API_URL=http://127.0.0.1:8010
HL_API_KEY=your-hl-api-key
